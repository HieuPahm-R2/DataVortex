DB_PASSWORD=replace-with-your-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-password
MYSQL_PORT=3306
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-different-keycloak-password
KEYCLOAK_PORT=8081
OIDC_ISSUER_URI=http://localhost:8081/realms/adinsight
OIDC_AUDIENCE=adinsight-api
